# Application
JOBRADAR_PORT=8080

# Local PostgreSQL
POSTGRES_DB=jobradar
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=jobradar

# Scheduled ingestion
JOBRADAR_INGESTION_SCHEDULE_ENABLED=false
JOBRADAR_INGESTION_SCHEDULE_PAGE=1
JOBRADAR_INGESTION_SCHEDULE_FIXED_DELAY=PT1H
JOBRADAR_INGESTION_SCHEDULE_INITIAL_DELAY=PT30S

# Relevance scoring
JOBRADAR_SCORING_TARGET_ROLES=Data Engineer,Analytics Engineer,Machine Learning Engineer,AI Engineer
JOBRADAR_SCORING_SKILLS=SQL,Python,Java,Spring Boot,PostgreSQL,Docker,Apache Kafka,Apache Spark,Apache Airflow,AWS,Machine Learning
JOBRADAR_SCORING_PREFERRED_JOB_TYPES=Full-time
JOBRADAR_SCORING_REMOTE_PREFERRED=true
